{
  "name": "toko-velg-ban",
  "version": "1.0.0",
  "description": "Website katalog velg dan ban mobil",
  "scripts": {
    "build:data": "node scripts/build-katalog.js",
    "dev:css": "tailwindcss -i ./src/css/tailwind.css -o ./src/_css/style.css --watch",
    "dev:11ty": "eleventy --serve --port=8080",
    "dev": "npm run build:data && npm-run-all --parallel dev:css dev:11ty",
    "build:css": "tailwindcss -i ./src/css/tailwind.css -o ./src/_css/style.css --minify",
    "build:11ty": "eleventy",
    "build": "npm run build:data && npm run build:css && npm run build:11ty",
    "clean": "rm -rf _site src/data src/_css/style.css"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.0"
  }
}
