{
  "name": "toko-velg-ban",
  "version": "1.0.0",
  "description": "Website katalog velg dan ban mobil",
  "scripts": {
    "build:data": "node scripts/build-katalog.js",
    "dev:css": "tailwindcss -i ./src/css/tailwind.css -o ./src/_css/style.css --watch",
    "dev:site": "eleventy --serve --port=8080",
    "dev": "npm run build:data && npm-run-all --parallel dev:css dev:site",
    "build:css": "tailwindcss -i ./src/css/tailwind.css -o ./src/_css/style.css --minify",
    "build:site": "eleventy",
    "build": "npm run build:data && npm run build:css && npm run build:site",
    "clean:site": "rm -rf public",
    "clean:data": "rm -rf src/data",
    "clean:css": "rm -rf src/_css/style.css",
    "clean": "npm run clean:site && npm run clean:data && npm run clean:css"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "@nichoth/eleventy-plugin-sitemap": "^2.2.0",
    "js-yaml": "^5.5.0"
  }
}
