---
layout: base.njk
title: Katalog
description: Kami menyediakan beragam pilihan ban, velg, dop, aksesoris, dan perlengkapan mobil dengan pilihan produk yang beragam dan harga bersahabat.
permalink: "/katalog/"
---

<section class="py-12">
  <div class="max-w-7xl mx-auto px-5">
    <h1 class="text-3xl font-bold text-center mb-8">Katalog Produk</h1>

    <!-- Filter bar -->
    <div class="bg-white p-5 rounded-xl shadow-sm mb-8 flex flex-wrap gap-3">
      <input type="text" id="filter-cari" placeholder="Cari produk..."
        class="flex-1 min-w-[200px] px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand">

      <select id="filter-kategori" class="px-4 py-2.5 border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-brand">
        <option value="">Semua Kategori</option>
      </select>

      <select id="filter-merek" class="px-4 py-2.5 border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-brand">
        <option value="">Semua Merek</option>
      </select>

      <select id="filter-ukuran" class="px-4 py-2.5 border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-brand">
        <option value="">Semua Ukuran</option>
        <option value="15">Ring 15</option>
        <option value="16">Ring 16</option>
        <option value="17">Ring 17</option>
        <option value="18">Ring 18</option>
        <option value="19">Ring 19</option>
        <option value="20">Ring 20</option>
      </select>
    </div>

    <!-- Grid produk -->
    <div id="grid-produk"
         class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
    </div>

    <!-- Tombol muat lebih banyak -->
    <div class="text-center mt-8">
      <button id="muat-lagi"
        class="hidden bg-brand text-white font-semibold px-7 py-3 rounded-lg hover:bg-brand-dark transition-colors">
        Muat Lebih Banyak
      </button>
    </div>
  </div>
</section>

{% block scripts %}
<script src="/js/katalog.js"></script>
{% endblock %}
