---
layout: base.njk
pagination:
  data: produk
  size: 1
  alias: item
permalink: "/produk/{{ item.id }}/"
eleventyComputed:
  title: "{{ item.nama }}"
  description: "{{ item.deskripsi }}"
---
<section class="py-12">
  <div class="max-w-7xl mx-auto px-5">
    <a href="/katalog/" class="text-brand hover:underline text-sm font-medium">← Kembali ke Katalog</a>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 bg-white p-6 md:p-8 rounded-xl shadow-sm mt-6">
      <img src="/img/{{ item.gambar }}" alt="{{ item.nama }}"
           class="w-full aspect-square object-cover rounded-lg bg-gray-100"
           width="1024" height="1024" loading="eager">

      <div>
        <span class="text-xs uppercase tracking-wide text-brand font-semibold">{{ item.kategori }}</span>
        <h1 class="text-2xl font-bold mt-1 mb-2">{{ item.nama }}</h1>
        <div class="text-3xl font-bold text-brand my-4">{{ item.harga | rupiah }}</div>
        <p class="font-semibold {{ 'text-emerald-600' if item.stok else 'text-red-500' }} mb-4">
          {{ "✔ Stok tersedia" if item.stok else "✘ Stok habis" }}
        </p>

        <table class="w-full text-sm mb-4">
          <tr><td class="py-2 text-gray-500 w-2/5">Merek</td><td class="py-2 font-medium">{{ item.merek }}</td></tr>
          {% if item.kategori.includes("velg") %}
            <tr class="border-t border-gray-100"><td class="py-2 text-gray-500">Ring</td><td class="py-2 font-medium">{{ item.ukuran }}</td></tr>
            <tr class="border-t border-gray-100"><td class="py-2 text-gray-500">PCD</td><td class="py-2 font-medium">{{ item.pcd }}</td></tr>
            <tr class="border-t border-gray-100"><td class="py-2 text-gray-500">Offset</td><td class="py-2 font-medium">{{ item.offset }}</td></tr>
          {% endif %}          
          {% if item.kategori.includes("ban") %}
            <tr class="border-t border-gray-100"><td class="py-2 text-gray-500">Ukuran</td><td class="py-2 font-medium">{{ item.lebar }}/{{ item.rasio }} R{{ item.ring }}</td></tr>
            <tr class="border-t border-gray-100"><td class="py-2 text-gray-500">Tipe</td><td class="py-2 font-medium">{{ item.tipe or "-" }}</td></tr>
          {% endif %}
          {% if not (item.kategori.includes("velg") or item.kategori.includes("ban")) %}
            <tr class="border-t border-gray-100"><td class="py-2 text-gray-500">Ukuran</td><td class="py-2 font-medium">{{ item.ukuran }}</td></tr>
          {% endif %}
        </table>

        <p class="text-gray-600 leading-relaxed my-4">{{ item.deskripsi }}</p>

        <a href="https://wa.me/6281214424448?text={{ ('Halo, saya tertarik dengan produk *' + item.nama + '*. Apakah masih tersedia?') | urlencode }}"
           target="_blank"
           class="inline-block bg-brand text-white font-semibold px-7 py-3 rounded-lg hover:bg-brand-dark transition-colors block text-center mt-5">
          💬 Tanya via WhatsApp
        </a>
        {% if item.stok %}
        <button onclick="beliOtomatis('{{ item.id }}', this)" class="inline-block bg-brand text-white font-semibold px-7 py-3 rounded-lg hover:bg-brand-dark transition-colors block text-center mt-5">
              🛒 Beli Produk
            </button>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% block scripts %}
<script src="/js/produk_detail.js"></script>
{% endblock %}
